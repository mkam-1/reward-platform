# Local dev config for docker-compose, loaded automatically from a file
# named `.env` in this directory. Copy this file to `.env` (gitignored —
# never commit real values) and adjust if needed.
#
# Everything below is a throwaway local value, not a real credential —
# see the README section on where real secrets belong in production.

POSTGRES_USER=reward
POSTGRES_PASSWORD=reward
POSTGRES_DB=reward_platform

# DynamoDB Local doesn't check credentials at all, but the AWS SDK still
# insists *some* value be present for every credential field before it
# will even attempt a request — these are placeholders to satisfy that,
# not real AWS keys.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1
