terraform {
  required_version = ">= 1.5"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }

  # Remote state: S3 for the state file, DynamoDB for the lock table —
  # the standard pair before Terraform 1.10's native S3 locking existed,
  # and still what most real-world configs run today. This backend
  # itself has a bootstrap problem (the S3 bucket + lock table must
  # exist before Terraform can use them to store *this* config's own
  # state) — see infra/terraform/bootstrap/ for the one-time, local-state
  # apply that creates them.
  #
  # Left as a partial (empty) backend block on purpose: the concrete
  # bucket/key/table values are supplied at `terraform init` time —
  # either from backend.hcl (`terraform init -backend-config=backend.hcl`,
  # for running this module standalone) or generated by Terragrunt
  # (../terragrunt/terragrunt.hcl's `remote_state` block, one state key
  # per environment) when run that way instead. A hardcoded key here
  # would collide with Terragrunt's generated one.
  backend "s3" {}
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project   = "reward-platform"
      ManagedBy = "terraform"
    }
  }
}
